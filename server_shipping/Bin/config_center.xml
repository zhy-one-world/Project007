<?xml version="1.0" encoding="utf-8"?>
<!--
  Config Center 独立配置。
  运行目录：config_center.xml
  报名校验：app_key + game_id + is_open；通过后登记服务器类型 / game_id / 内外网地址，供同 game_id 互联。
  app_key 须与 servers.xml 的 server_base/app_key 一致。
  is_open="false" 时该 game_id 拒绝报名。
-->
<config_center>
	<app_key>100001</app_key>
	<listen_host>0.0.0.0</listen_host>
	<listen_port>19000</listen_port>
	<use_https>true</use_https>
	<heartbeat_ttl_sec>30</heartbeat_ttl_sec>
	<ssl>
		<cert_file>cert.pem</cert_file>
		<key_file>key.pem</key_file>
	</ssl>
	<redis>
		<host>127.0.0.1</host>
		<port>6379</port>
		<db>0</db>
		<password></password>
	</redis>

	<allowed>
		<game game_id="10200" is_open="true"/>
	</allowed>
</config_center>

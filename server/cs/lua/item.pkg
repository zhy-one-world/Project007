/*
	lua 调用C++函数统一处理接口
*/
namespace hld
{

	
	enum e_item_color
	{
		e_item_color_white = 1,		// 白色
		e_item_color_green,			// 绿色
		e_item_color_blue,			// 蓝色
		e_item_color_purple,		// 紫色
		e_item_color_orange,		// 橙色
		e_item_color_red,			// 紅色
		e_item_color_pink,			// 粉色
		e_item_color_max
	};
	
	enum e_item_lock_states 
	{
		e_item_unlocked,
		e_item_locked,
	};
	
	class citem
	{
	public:
		int get_item_guid_A();
		int get_item_guid_B();
		guid_64 get_item_guid();
		int get_data_info(e_item_info eIndex);
		void set_data_info(e_item_info eIndex, long long iValue);
		int get_real_id();
		const s_item_info& get_item_inst();
		s_item_info get_item_inst_tem();
		int get_item_template_id();
		ItemTemplate* get_item_info_ptr();
		EquipTemplate* get_equip_info_ptr();
		ItemUpgradeTemplate* get_upgrade_info_ptr();
		int get_item_logic_id();
		int get_item_color();
		int get_excellent_att_num(); // 获得装备卓越属性的个数
		int have_not_save_forge_att_num();//存在未保存的属性的条数
		void set_forge_property(int i);
		int get_forge_att(int item_data_index);
		int get_forge_name_att(int item_data_index);
		int get_forge_name_flag_att(int item_data_index);

		void	set_temp_succinct_att(item_temp_succinct_property index , int value);
		int		get_temp_succinct_att(item_temp_succinct_property index);
		int 	get_item_grade();
		int		get_item_succinct_level();
		
		int		get_forge_change_gs(int player_index);
	}
}
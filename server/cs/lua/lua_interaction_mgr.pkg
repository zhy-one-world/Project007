namespace hld
{
	class cinteraction_mgr
	{
	public:
		void stop_interaction();
		bool get_is_inviter();
		void set_is_inviter(bool is_inviter);
		void set_interaction_info(guid_64 target_guid, e_interaction_type interaction_type);
		void send_interaction_answer_to_two_side(guid_64 invite_guid, e_interaction_type interaction_type, e_interaction_reply result);
		e_interaction_state	get_interaction_state();
		guid_64 get_interaction_guid();
		void recv_interaction_invite(guid_64 invite_guid, hld::e_interaction_type interaction_type);
		void recv_interaction_answer(guid_64 invite_guid, hld::e_interaction_type interaction_type, hld::e_interaction_reply result);
		void recv_real_start_interaction(guid_64 be_invited_guid, hld::e_interaction_type interaction_type);
	}	
	
	enum e_interaction_state
	{
		e_interaction_state_none,
		e_interaction_state_wait_reply,
		e_interaction_state_wait_start_real_interaction,
		e_interaction_state_interacting,
	};
}
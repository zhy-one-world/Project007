/*
	lua 调用C++函数统一处理接口
*/
namespace hld
{
	class oracle_trial_mgr
	{
	public:
	    bool load_oracle_trial_by_db_lua(const char *data_ptr, int data_len);
		void set_play_oracle_trial_info(int tier_num, int customs_num, int customs_state);
		void set_play_oracle_trial_reward_info(int tier_num, int reward_num, int reward_state);
		int get_tier_customs_state_info(int tier_num);
		int get_tier_reward_state_info(int tier_num);
		void save_oracle_trial_to_db(int tier_num);
		int get_hight_rank_num();
		void send_commingup_item_list(int item_id[10], int item_num[10], int _item_num);
		void send_fuben_over_info(int map_id, int old_statr, int new_statr);
		item_num_info get_drop_list_by_id(int drop_id);
		void send_mopping_up_award();
	}	
	struct item_num_info
	{
		int						item_id[10];
		int						item_num[10];
		int						num;
		item_num_info()
		{
			clear_data();
		}
		void clear_data()
		{
			memset(this, 0, sizeof(item_num_info));
		}
	};
	
}
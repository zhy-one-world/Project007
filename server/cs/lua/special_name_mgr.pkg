{
	enum e_special_name_type
	{
		e_special_name_type_acheivement = 0,	//	成就称号
		e_special_name_type_acheivement_star,
		e_special_name_type_military_rank,		//	军衔称号
		e_special_name_type_military_rank_star,
		e_special_name_type_max,				//称号的最大值				
	};
	
	enum e_special_name_operate_type
	{
		e_special_name_operate_upgrade,		//	升级
		e_special_name_operate_promote,		//	升星 
	};
	enum e_special_name_upgrade_end_state
	{
		e_special_name_upgrade_succeed,		//成功
		e_special_name_upgrade_fail,		//失败
	};
	
	class special_name_mgr
	{
	public:
	   bool load_data_by_db_lua(const char *data_ptr, int data_len);
       void	sync_military_rank_to_ws();
	   void sync_ranking_special_name(int name_type);
		int	get_value_by_id(int id);
		void send_special_name_upgrade_notice(const int& name_type);
		int	get_name_level_by_type(int name_type);
		bool set_value_by_id(int id, int value);
		void send_special_name_operate_end_msg(bool success,int name_type,int operate_type);
		int get_solider_rank_level();
		int	get_solider_rank_star();
		int	get_achievement_title_level();
	};
}
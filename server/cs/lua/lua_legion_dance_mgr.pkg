/*
	lua 调用C++函数统一处理接口
*/
namespace hld
{
	class legion_dance_mgr
	{
	public:
		void send_legion_dance_invite_error_tip(e_legion_dance_invite_error error_index, string role_name);
		void send_legion_dance_accept_error_tip(e_legion_dance_accept_error error_index, string role_name);
		int get_world_server_last_level();
		void send_legion_dance_invite(int target_index);
		void legion_dance_official_start(guid_64 str_target_guid);
	}	
	  enum e_legion_dance_invite_error
     {
		e_legion_dance_invite_error_player_info_error,
		e_legion_dance_invite_error_not_in_map,
		e_legion_dance_invite_error_not_in_game,
		e_legion_dance_invite_error_in_war,
		e_legion_dance_invite_error_my_in_war,
		e_legion_dance_invite_error_target_refuse,
     };
	 
	 enum e_legion_dance_accept_error
	{
		e_legion_dance_accept_error_player_info_error,				
		e_legion_dance_accept_error_not_in_map,						
		e_legion_dance_accept_error_not_in_game,				
		e_legion_dance_accept_error_in_war,							
		e_legion_dance_accept_error_my_in_war,						
		e_legion_dance_accept_error_in_interactive,									
	};
}
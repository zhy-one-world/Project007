/*
	lua 调用C++函数统一处理接口
*/
namespace hld
{
	class unit;
	class npc;
	class player;
	class skill_set;
	class buff_set;
	class item_set;
	class map_object;
	class raid_map_cs;
	class map_record_set;
	guid_64* get_guid_64(int64 value);
	guid_64* get_guid_64(int32 a, int32 b);
	guid_64* get_guid_64();

	unit*	get_unit_by_guid(guid_64 unit_guid);
	npc*	get_npc_by_guid(guid_64 unit_guid);
	player*	get_player_by_guid(guid_64 unit_guid);
	unit*	get_unit_by_guid(int unit_guid_A, int unit_guid_B);
	npc*	get_npc_by_guid(int unit_guid_A, int unit_guid_B);
	player*	get_player_by_guid(int unit_guid_A, int unit_guid_B);
	unit*	get_unit_by_index(int unit_index);
	npc*	get_npc_by_index(int unit_index);
	player*	get_player_by_index(int unit_index);
	player* get_player_by_name(std::string name);
	skill_set* get_skill_set_by_index(int unit_index);
	buff_set* get_buff_set_by_index(int unit_index);
	item_set* get_item_set_by_index(int unit_index);
	map_object*	get_map(guid_64 map_guid);
	raid_map_cs* get_raid_map_cs(guid_64 map_guid);
	std::string get_str_by_string_template_id(int template_id, int index);
	
	std::string guid_transfer_to_string(int guid_A, int guid_B);
	int		get_guid_A(std::string guid_value);
	int  	get_guid_B(std::string guid_value);
	
	map_record_set* get_map_record_set_by_index(int unit_index);
	
	cell_server * get_cell_server();
}


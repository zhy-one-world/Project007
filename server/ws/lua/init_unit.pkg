/*
	lua 调用C++函数统一处理接口
*/
namespace hld
{
	class init_unit
	{
	public:
		static int get_left_shift_operation_result(int left_operator, int right_operator);
		static int get_bitwise_and_operation_result(int left_operator, int right_operator);
		static int get_bitwise_or_operation_result(int left_operator, int right_operator);
		static e_bag_type get_item_bag_type(int item_template_id);
		static bool is_can_use_this_jewel_slot_on_this_equip_level(int equip_level, int slot_index);
		static bool is_can_use_this_jewel_slot_on_this_vip_level(int role_vip_level, int slot_index);
		static int get_flag_data(int _flag_datas, int _idx);
		static int get_max_player_level();
		static int get_max_grade_level();
		static bool is_big_endian();
		static bool is_cross_server_big_player(int32 player_type, bool is_begin_cross_activity = false, bool is_begin_cross_city_war = false);
		static bool init_item_data(s_item_info& msg_data, int32 template_id, int32 slot, int32 stack_count, e_bag_type container_type, int32 is_activate, int32 locked = 1, int32 item_over_time = 0, int32 item_const_att = 0);
	};
}